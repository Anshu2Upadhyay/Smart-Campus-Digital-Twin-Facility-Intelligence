# ==============================================================================
# Smart Campus Digital Twin & Facility Intelligence Platform
# Root Environment Template
# ==============================================================================
# Copy this file to `backend/.env` for FastAPI server configuration,
# and configure `frontend/.env` (or let it fallback to default localhost:8000).

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
APP_NAME="Smart Campus Digital Twin & Facility Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=false

# MongoDB Database Configuration
MONGODB_URL=mongodb://localhost:27017
DB_NAME=smart_campus_digital_twin

# Security & JWT Authentication
JWT_SECRET_KEY=campus-digital-twin-ultra-secret-key-2026
JWT_SECRET=campus-digital-twin-ultra-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Energy & Tariff Settings (INR ₹ per kWh commercial unit)
ELECTRICITY_TARIFF_PER_KWH=8.5

# SLA Deadlines & Autopilot Thresholds (Seconds & Minutes)
SLA_SUPERVISOR_AUTOPILOT_SECONDS=60
SLA_WORKER_ACCEPT_SECONDS=180
SLA_ESCALATION_SECONDS=600
GHOST_ENERGY_VACANT_MINUTES=10

# AI / Vision / Gemini Integration (Optional - powers RAG & Visual Threat Analysis)
GEMINI_API_KEY=

# File Upload Directory (Relative to backend directory)
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000
