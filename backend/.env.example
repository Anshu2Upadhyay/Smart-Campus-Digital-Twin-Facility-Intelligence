# Smart Campus Digital Twin & Facility Intelligence Platform
# Environment Configuration Template

# Server & Application
APP_NAME="Smart Campus Digital Twin & Facility Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=false

# MongoDB Database Configuration
MONGODB_URL=mongodb://localhost:27017
DB_NAME=smart_campus_digital_twin

# Security & JWT Authentication
JWT_SECRET_KEY=campus-digital-twin-ultra-secret-key-2026
JWT_SECRET=campus-digital-twin-ultra-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Energy & Tariff Settings (INR ₹ per kWh unit)
ELECTRICITY_TARIFF_PER_KWH=8.5

# SLA Deadlines & Autopilot Thresholds (Seconds & Minutes)
SLA_SUPERVISOR_AUTOPILOT_SECONDS=60
SLA_WORKER_ACCEPT_SECONDS=180
SLA_ESCALATION_SECONDS=600
GHOST_ENERGY_VACANT_MINUTES=10

# AI / Vision / Gemini Integration (Optional)
GEMINI_API_KEY=

# File Upload Directory
UPLOAD_DIR=uploads
