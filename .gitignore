# ---------------------------------------------------------------
# Smart Campus Digital Twin & Facility Intelligence Platform
# Root .gitignore — Production-grade ignore rules
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Frontend Build & Production Artifacts
dist/
dist-ssr/
build/
out/
.next/
*.timestamp-*.mjs

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.coverage
.coverage.*
*.cover
.pytest_cache/
.tox/
.nox/
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment Variables & Secrets (NEVER commit real credentials)
.env
.env.*
!.env.example
*.env
*.env.local

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & Filesystem Cache
.DS_Store
.DS_Store?
._*
[Dd]esktop.ini
Thumbs.db
ehthumbs.db
*.orig
*~

# IDE & Editor Preferences
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.csproj
*.swp
*.swo

# Runtime Uploads, Video Clips & Large ML Binaries
uploads/
!uploads/.gitkeep
clips/
*.onnx
*.pt
*.pth
*.weights
*.bin
*.mp4
*.avi
*.mkv

# Temporary Caches
.turbo/
.cache/
.eslintcache
